#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  codex-switch list
  codex-switch login <account> [--force]
  codex-switch status [account]
  codex-switch [cli] [account] [codex arguments...]
  codex-switch code [account] [path or VS Code arguments...]

Named accounts keep separate authentication under ~/.codex-<account>.
All accounts share local Codex sessions and SQLite-backed thread history.
If an account is omitted, an interactive account picker is shown.
EOF
}

account_dir() {
  local account="$1"
  if [[ ! "$account" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
    printf 'Invalid account name: %s\n' "$account" >&2
    exit 2
  fi
  printf '%s/.codex-%s' "$HOME" "$account"
}

shared_root() {
  printf '%s' "${CODEX_SWITCH_SHARED_HOME:-$HOME/.codex-shared}"
}

prepare_account() {
  local dir="$1"
  local root
  root="$(shared_root)"

  install -d -m 700 "$root" "$root/sessions" "$root/sqlite" "$root/thread-writer-locks"

  local name path target actual
  for name in sessions thread-writer-locks; do
    path="$dir/$name"
    target="$root/$name"
    if [[ -L "$path" ]]; then
      actual="$(readlink -f "$path")"
      if [[ "$actual" != "$target" ]]; then
        printf 'Unexpected %s link for %s: %s\n' "$name" "$dir" "$actual" >&2
        exit 1
      fi
    elif [[ -e "$path" ]]; then
      printf '%s is not connected to shared Codex storage.\n' "$path" >&2
      printf 'Restore the migration or move its contents into %s first.\n' "$target" >&2
      exit 1
    else
      ln -s "$target" "$path"
    fi
  done

  export CODEX_SQLITE_HOME="$root/sqlite"
}

require_account() {
  local dir="$1"
  if [[ ! -f "$dir/auth.json" ]]; then
    printf 'Account is not logged in: %s\n' "$dir" >&2
    printf 'Run: codex-switch login <account>\n' >&2
    exit 1
  fi
}

select_account() {
  local dirs=() accounts=() dir account

  if [[ ! -t 0 ]]; then
    printf 'An account is required when input is not interactive.\n' >&2
    exit 2
  fi

  shopt -s nullglob
  dirs=("$HOME"/.codex-*)
  shopt -u nullglob
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" && -f "$dir/auth.json" ]] || continue
    [[ "$dir" == "$(shared_root)" ]] && continue
    [[ "${dir##*/}" == .codex-account-backup-* ]] && continue
    [[ "${dir##*/}" == .codex-switch-backup-* ]] && continue
    [[ "${dir##*/}" == .codex-switch-migration-backup.* ]] && continue
    accounts+=("${dir##*/.codex-}")
  done

  if [[ "${#accounts[@]}" -eq 0 ]]; then
    printf 'No logged-in Codex accounts found.\n' >&2
    printf 'Run: codex-switch login <account>\n' >&2
    exit 1
  fi

  printf 'Select a Codex account:\n' >&2
  PS3='Account: '
  select account in "${accounts[@]}"; do
    if [[ -n "$account" ]]; then
      printf '%s\n' "$account"
      return
    fi
    printf 'Please enter a number from 1 to %s.\n' "${#accounts[@]}" >&2
  done

  printf 'No account selected.\n' >&2
  exit 1
}

if [[ "$#" -eq 0 ]]; then
  command_name=cli
else
  case "$1" in
    list|login|status|cli|code)
      command_name="$1"
      shift
      ;;
    *)
      command_name=cli
      ;;
  esac
fi

case "$command_name" in
  list)
    found=false
    shopt -s nullglob
    for dir in "$HOME"/.codex-*; do
      [[ -d "$dir" ]] || continue
      [[ "$dir" == "$(shared_root)" ]] && continue
      [[ "${dir##*/}" == .codex-account-backup-* ]] && continue
      [[ "${dir##*/}" == .codex-switch-backup-* ]] && continue
      [[ "${dir##*/}" == .codex-switch-migration-backup.* ]] && continue
      found=true
      account="${dir##*/.codex-}"
      if [[ -f "$dir/auth.json" ]]; then
        printf '%s\tlogged in\n' "$account"
      else
        printf '%s\tnot logged in\n' "$account"
      fi
    done
    if [[ "$found" == false ]]; then
      printf 'No named Codex accounts found.\n'
    fi
    ;;

  login)
    account="${1:-}"
    [[ -n "$account" ]] || { usage; exit 2; }
    force="${2:-}"
    [[ -z "$force" || "$force" == "--force" ]] || { usage; exit 2; }
    [[ "$#" -le 2 ]] || { usage; exit 2; }
    dir="$(account_dir "$account")"
    install -d -m 700 "$dir"
    if [[ ! -f "$dir/config.toml" ]]; then
      printf '%s\n' 'cli_auth_credentials_store = "file"' > "$dir/config.toml"
      chmod 600 "$dir/config.toml"
    fi
    prepare_account "$dir"
    if [[ "$force" != "--force" && -f "$dir/auth.json" ]] && \
      CODEX_HOME="$dir" codex login status >/dev/null 2>&1; then
      printf 'Account %s is already logged in. Use --force to log in again.\n' "$account"
      exit 0
    fi
    CODEX_HOME="$dir" exec codex login
    ;;

  status)
    account="${1:-}"
    if [[ -n "$account" ]]; then
      shift
    else
      account="$(select_account)"
    fi
    [[ "$#" -eq 0 ]] || { usage; exit 2; }
    dir="$(account_dir "$account")"
    require_account "$dir"
    prepare_account "$dir"
    CODEX_HOME="$dir" exec codex login status
    ;;

  cli)
    account="${1:-}"
    if [[ -n "$account" ]]; then
      shift
    else
      account="$(select_account)"
    fi
    dir="$(account_dir "$account")"
    require_account "$dir"
    prepare_account "$dir"
    CODEX_HOME="$dir" exec codex "$@"
    ;;

  code)
    account="${1:-}"
    if [[ -n "$account" ]]; then
      shift
    else
      account="$(select_account)"
    fi
    dir="$(account_dir "$account")"
    require_account "$dir"
    prepare_account "$dir"

    code_data_dir="$HOME/.config/Code-codex-$account"
    if [[ ! -d "$code_data_dir/User" ]]; then
      install -d -m 700 "$code_data_dir/User"
      for filename in settings.json mcp.json; do
        source_file="$HOME/.config/Code/User/$filename"
        if [[ -f "$source_file" ]]; then
          cp -p "$source_file" "$code_data_dir/User/$filename"
        fi
      done
    fi

    CODEX_HOME="$dir" exec code \
      --user-data-dir "$code_data_dir" \
      --extensions-dir "$HOME/.vscode/extensions" \
      --new-window "$@"
    ;;

  *)
    usage
    exit 2
    ;;
esac
